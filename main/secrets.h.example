/* Copy to secrets.h (which git ignores) and fill in, or let
 * tools/ecoflow_secrets.py write it for you. Never commit, log or post these:
 * together they are the Bluetooth login for your power station. */
#pragma once

/* 16 characters, from the unit's label or the EcoFlow app. */
#define ECOFLOW_SERIAL "R351XXXXXXXXXXXX"

/* Numeric ID of the EcoFlow account the unit is bound to. */
#define ECOFLOW_USER_ID "0000000000000000000"
