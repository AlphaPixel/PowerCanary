CONFIG_IDF_TARGET="esp32c5"

# Bluetooth LE with the NimBLE host; legacy advertising reports while scanning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=n

# The USB serial port carries the Megatec protocol and nothing else, so the
# log console is UART0 only, with no copy of the log on USB.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The ROM still mirrors early output to USB, so keep start-up quiet: no
# bootloader log, and errors only until the application raises the level.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# A task that stops running resets the chip instead of only logging it.
CONFIG_ESP_TASK_WDT_PANIC=y
